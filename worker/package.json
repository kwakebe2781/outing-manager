{
  "name": "goplan-cloud-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create goplan-db",
    "db:migrate:local": "wrangler d1 migrations apply goplan-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply goplan-db --remote",
    "generate:vapid": "node scripts/generate-vapid.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}